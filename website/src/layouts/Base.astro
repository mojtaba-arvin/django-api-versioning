---
import "../styles/global.css";
import "../styles/site.css";
import Logo from "../components/Logo.astro";
import { source, shortCommit, env, commitUrl, pypiUrl, repoUrl, generatedDate } from "../lib/data";

interface Props {
  title: string;
  description: string;
  progress?: boolean;
  current?: "home" | "evidence" | "explorer" | "articles";
}
const { title, description, progress = false, current } = Astro.props;
const fullTitle = title === source.package ? `${source.package} ${source.version} — routing behaviour, recorded` : `${title} · ${source.package}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const nav = [
  { href: "/#capabilities", label: "Capabilities", key: "home" },
  { href: "/explorer/", label: "Segment Explorer", key: "explorer" },
  { href: "/evidence/", label: "Evidence", key: "evidence" },
  { href: "/articles/", label: "Articles", key: "articles" },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f3ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101216" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Runs before first paint: theme, motion preference and JS flag. No layout shift. -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add("js");
        try {
          const t = localStorage.getItem("dav-theme");
          if (t === "light" || t === "dark") d.dataset.theme = t;
          const m = localStorage.getItem("dav-motion");
          if (m === "reduce") d.dataset.motion = "reduce";
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {progress && <div class="reading-progress" aria-hidden="true"></div>}
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label={`${source.package} home`}>
          <Logo size={14} />
          <span class="brand-name">django-api-versioning</span>
        </a>

        <nav class="nav-desktop" aria-label="Primary">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current === n.key && n.key !== "home" ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="header-tools">
          <a class="btn search-trigger" href="/articles/" data-search-open aria-haspopup="dialog">
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="12.6" y1="12.6" x2="17" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span>Search</span><kbd class="js-only" aria-hidden="true">/</kbd>
          </a>

          <details class="version-info" data-dismissable>
            <summary aria-label={`Version information: ${source.package} ${source.version}, commit ${shortCommit}`}>
              <span class="vi-dot" aria-hidden="true"></span>
              <span>v{source.version}</span>
              <span class="vi-commit">{shortCommit}</span>
            </summary>
            <div class="vi-panel">
              <p class="vi-title">Every recorded behaviour on this site comes from:</p>
              <dl>
                <dt>Package</dt><dd><a href={pypiUrl}>{source.package} {source.version}</a></dd>
                <dt>Commit</dt><dd><a href={commitUrl}><code>{shortCommit}</code></a> <span class="muted">(main and tag v{source.version})</span></dd>
                <dt>Django</dt><dd>{env.django}</dd>
                <dt>DRF</dt><dd>{env.djangorestframework}</dd>
                <dt>Python</dt><dd>{env.python}</dd>
                <dt>Recorded</dt><dd><time datetime={generatedDate}>{generatedDate}</time></dd>
              </dl>
              <a class="btn" href="/evidence/#provenance">Provenance and file hashes</a>
            </div>
          </details>

          <button class="icon-btn js-only" type="button" data-theme-toggle aria-label="Dark theme" aria-pressed="false" title="Toggle dark theme">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </button>
          <button class="icon-btn js-only" type="button" data-motion-toggle aria-label="Reduce motion" aria-pressed="false" title="Reduce motion">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
          </button>

          <details class="nav-mobile" data-dismissable>
            <summary aria-label="Menu">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </summary>
            <nav aria-label="Primary (mobile)">
              <ul>
                {nav.map((n) => (
                  <li><a href={n.href} aria-current={current === n.key && n.key !== "home" ? "page" : undefined}>{n.label}</a></li>
                ))}
                <li><a href={repoUrl}>GitHub</a></li>
                <li><a href={pypiUrl}>PyPI</a></li>
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <div>
          <a class="brand" href="/"><Logo size={12} /><span class="brand-name">django-api-versioning</span></a>
          <p class="muted footer-note">
            An independent inspection site. Recorded from {source.package} {source.version} at
            <a href={commitUrl}><code>{shortCommit}</code></a> by <code>tools/generate_routes.py</code>.
            Package © its authors, MIT licence.
          </p>
        </div>
        <ul class="footer-links">
          <li><a href={repoUrl}>GitHub</a></li>
          <li><a href={pypiUrl}>PyPI</a></li>
          <li><a href="/evidence/">Evidence</a></li>
          <li><a href="/data/routes.json">routes.json</a></li>
          <li><a href="/articles/">Articles</a></li>
        </ul>
      </div>
    </footer>

    <dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title">
      <form method="dialog" class="search-form" role="search" onsubmit="return false">
        <h2 id="search-title" class="sr-only">Search the site</h2>
        <label class="sr-only" for="search-input">Search articles, scenarios and sections</label>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="12.6" y1="12.6" x2="17" y2="17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input id="search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Search: ViewSet, request.version, sunset…" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
        <button class="btn" type="button" data-search-close>Close <kbd>Esc</kbd></button>
      </form>
      <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
      <ul class="search-results" id="search-results" role="listbox" aria-label="Results"></ul>
    </dialog>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>