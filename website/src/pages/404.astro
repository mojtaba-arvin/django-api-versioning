---
import Base from "../layouts/Base.astro";
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const homeHref = basePath;
---
<Base title="Page not found" description="The requested page could not be found.">
  <div class="wrap page-shell">
    <p class="eyebrow">404 · Not found</p>
    <h1>This route does not exist.</h1>
    <p class="lede">The site is static; check the URL or return to the home page.</p>
    <a class="btn btn-accent" href={homeHref}>Back to the homepage</a>
  </div>
</Base>
