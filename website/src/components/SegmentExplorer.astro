---
import { scenarioNames, scenario, segmentsOf } from "../lib/data";
import SegmentDiagram from "./SegmentDiagram.astro";

interface Props {
  initialScenario?: string;
  initialPostfix?: string;
}
const { initialScenario = "main", initialPostfix = "users/" } = Astro.props;
const scenarios = scenarioNames.map((name) => {
  const current = scenario(name);
  const settings = current.effective_settings["django_api_versioning.settings.api_settings"];
  const routes = Object.keys(current.matrix)
    .map((postfix) => ({ postfix, segments: segmentsOf(current, postfix) }))
    .filter((route) => route.segments.length > 0);
  const error = current.urlconf_import.error?.message
    ?? current.recorded_errors?.map((item) => item.message).filter(Boolean).join(" ")
    ?? "";
  return {
    name,
    title: current.title,
    question: current.question,
    min: settings.API_MIN_VERSION,
    max: settings.API_MAX_VERSION,
    routes,
    error,
    registrySize: current.urlconf_import.registry_size_after,
    requestCount: current.requests.length,
  };
});
const initial = scenarios.find((item) => item.name === initialScenario) ?? scenarios[0];
const initialRoute = initial.routes.find((item) => item.postfix === initialPostfix) ?? initial.routes[0];
const serialized = JSON.stringify(scenarios).replace(/</g, "\\u003c");
---
<section class="explorer-panel" data-segment-explorer data-initial-route={initialRoute?.postfix ?? ""}>
  <p class="note">routing model / explanatory visualization, not actual Python execution</p>
  <div class="explorer-controls js-only">
    <label>
      Scenario
      <select data-explorer-scenario>
        {scenarios.map((item) => <option value={item.name} selected={item.name === initial.name}>{item.title}</option>)}
      </select>
    </label>
    <label>
      Route declaration
      <select data-explorer-route disabled={!initial.routes.length}>
        {initial.routes.map((route) => <option value={route.postfix} selected={route.postfix === initialRoute?.postfix}>{route.postfix}</option>)}
      </select>
    </label>
  </div>
  <p class="explorer-status" data-explorer-status role="status" aria-live="polite">
    {initial.title} · {initialRoute?.postfix ?? "No versioned route"} · {initial.routes.length} versioned route(s)
  </p>
  <div class="explorer-output" data-explorer-output aria-live="polite">
    <p class="explorer-question">{initial.question}</p>
    {initialRoute
      ? <SegmentDiagram scenario={scenario(initial.name)} postfix={initialRoute.postfix} />
      : <p class="note">{initial.error || "No versioned route segments were registered in this scenario."}</p>}
  </div>
  <script type="application/json" id="explorer-data" set:html={serialized}></script>
  <noscript>
    <p class="note">JavaScript is disabled. The default recorded scenario remains visible above; the interactive selectors require JavaScript.</p>
  </noscript>
</section>
