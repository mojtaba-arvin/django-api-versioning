---
interface Props {
  code: string;
  label: string;
  language?: string;
}
const { code, label, language = "text" } = Astro.props;
---
<figure class="codeblock" data-language={language}>
  <figcaption class="codeblock-header">
    <span>{label}</span>
    <span>{language}</span>
  </figcaption>
  <pre class="terminal"><code>{code}</code></pre>
</figure>
