---
/**
 * Segment Point mark. Reads left to right along a version axis:
 *  - first point: a declaration (version=N), carried forward as a segment;
 *  - second point: a newer declaration of the same route; the old segment
 *    stops exactly there and the new one continues;
 *  - end cap: API_MAX_VERSION. Nothing is registered beyond it.
 */
interface Props { size?: number; title?: string }
const { size = 32, title } = Astro.props;
---
<svg class="logo-mark" width={size * 2} height={size} viewBox="0 0 64 32" role={title ? "img" : undefined} aria-hidden={title ? undefined : "true"} aria-label={title}>
  <line x1="4" y1="27" x2="56" y2="27" stroke="currentColor" stroke-opacity=".28" stroke-width="1.5" />
  <line x1="7" y1="20" x2="31" y2="20" stroke="var(--seg-0)" stroke-width="4" stroke-linecap="butt" />
  <circle cx="7" cy="20" r="4.5" fill="var(--seg-0)" />
  <line x1="31" y1="10" x2="55" y2="10" stroke="var(--accent)" stroke-width="4" stroke-linecap="butt" />
  <line x1="31" y1="10" x2="31" y2="27" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="2 2" />
  <circle cx="31" cy="10" r="5.5" fill="var(--accent)" />
  <circle cx="31" cy="10" r="2" fill="var(--bg)" />
  <line x1="57.5" y1="4" x2="57.5" y2="30" stroke="currentColor" stroke-width="2.5" />
</svg>