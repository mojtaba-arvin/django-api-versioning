{
  "name": "django-api-versioning-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prebuild": "pnpm run sync:articles && pnpm run sync:reference",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run sync:articles && pnpm run sync:reference",
    "test": "vitest run && node --test scripts/check-dist.test.mjs",
    "sync:articles": "node scripts/sync-articles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:dist": "node scripts/check-dist.mjs",
    "test:dist:root": "PUBLIC_BASE_PATH=/ node scripts/check-dist.mjs dist/client /",
    "test:dist:subpath": "PUBLIC_BASE_PATH=/django-api-versioning node scripts/check-dist.mjs dist/client /django-api-versioning",
    "predev": "pnpm run sync:articles && pnpm run sync:reference",
    "sync:reference": "node scripts/sync-reference.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "marked": "18.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.12.1"
}
